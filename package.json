{
  "name": "cme-oi-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "node scripts/e2e.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "admin:grant": "node --env-file=.env.local --import tsx scripts/grant-admin.ts",
    "admin:unlock-login": "node --env-file=.env.local --import tsx scripts/unlock-login.ts",
    "admin:release-mt5": "node --env-file=.env.local --import tsx scripts/release-mt5.ts",
    "license:publish": "node --conditions=react-server --env-file=.env.local --import tsx scripts/publish-license.ts",
    "license:purge-mock": "node --conditions=react-server --env-file=.env.local --import tsx scripts/purge-mock-data.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
