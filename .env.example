# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (อย่า commit .env.local)

# PostgreSQL connection string (Neon / Supabase / local)
# ตัวอย่าง Neon: postgres://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# URL ของเว็บ (ใช้สร้างลิงก์ในอีเมลและ metadata) — ต้องตั้งให้ตรงโดเมนจริง "ก่อน build" (ค่าถูกฝังตอน build)
# ใช้เป็นต้นทางของลิงก์ชวนเพื่อน (/register?ref=...) ในหน้าบัญชีเมื่อเบราว์เซอร์ยังไม่โหลด JavaScript ด้วย
# (JavaScript โหลดแล้วใช้โดเมนของหน้าที่เปิดอยู่จริงแทน)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ลิงก์ LINE OA ของผู้ให้บริการ (ปุ่ม "สอบถามทาง LINE" ทุกจุดใช้ค่านี้) — ต้องเป็น https://... และต้องตั้ง "ก่อน build" (ค่าถูกฝังตอน build)
# ไม่ตั้ง: ทุกจุด "ติดต่อทีมงานทาง LINE" (รวมตอนระบบชำระเงินยังไม่เปิด/เปิด license ไม่สำเร็จ) เป็นข้อความเปล่า ไม่มีลิงก์
NEXT_PUBLIC_LINE_URL=

# ชื่อผู้ให้บริการ/บริษัทที่แสดงในเอกสารทางกฎหมาย
NEXT_PUBLIC_PROVIDER_NAME=

# โฮสต์ของไฟล์ license ที่ลูกค้าต้องอนุญาตใน MT5 (Tools → Options → Expert Advisors → Allow WebRequest)
NEXT_PUBLIC_LICENSE_HOST=https://license.example.com

# ที่เก็บรายชื่อ license: local (เขียนลงโฟลเดอร์ storage/ — ทดสอบเท่านั้น บอทไม่ได้อ่าน) หรือ firebase (ของจริงที่ indicator อ่าน)
# ต้องตั้งเองเสมอนอก `npm run dev`/เทส: ไม่ตั้ง หรือค่าที่ไม่รู้จัก (เช่น "Firebase") = เซิร์ฟเวอร์ production ไม่ให้บริการ (ทุกคำขอได้ 500 สาเหตุอยู่ใน log)
# และ `npm run license:publish` ไม่ทำงาน — ระบบไม่ถอยไปเขียนไฟล์ในเครื่องเงียบๆ (ลูกค้าจะเห็น "เปิดใช้งานแล้ว" ทั้งที่บอทไม่ได้รายชื่อ)
LICENSE_STORAGE=local
LICENSE_LOCAL_DIR=./storage
LICENSE_FILE_NAME=license.txt
LICENSE_PUBLIC_URL=/api/license-file

# Firebase Realtime Database (ใช้เมื่อ LICENSE_STORAGE=firebase)
FIREBASE_DATABASE_URL=https://cme-oi-system-dashborad-default-rtdb.asia-southeast1.firebasedatabase.app
# JSON ของ service account ทั้งก้อน (บรรทัดเดียว) หรือ path ของไฟล์ key — ห้าม commit
FIREBASE_SERVICE_ACCOUNT_JSON=
# เว้นว่าง = เขียน path ทดสอบ "CME_Data/Customer Data/Data_test"
# ใส่ "CME_Data/Customer Data/Data" เมื่อทำครบทุกข้อใน README "ก่อนเปิดระบบจริง" แล้วเท่านั้น
# (import รายชื่อเดิม, ล้างข้อมูลการชำระเงินจำลองหรือใช้ฐานข้อมูลใหม่, ทดสอบกับบอทจริง, ตั้ง cron license:publish รายวัน)
# path ต้องเป็น "CME_Data/Customer Data/<ชื่อเดียว>" — path ย่อยใต้ Data (เช่น .../Data/test) ถูกปฏิเสธ เพราะจะทำให้รายชื่อจริงหาย
FIREBASE_LICENSE_PATH=
# เพดานจำนวนบัญชีที่ยอมให้หายจากรายชื่อในการเขียนครั้งเดียว (ค่าเริ่มต้น 10)
FIREBASE_MAX_REMOVED_ENTRIES=

# ฐานข้อมูลสำหรับ integration test (npm run test:db) — ชื่อฐานข้อมูลต้องลงท้ายด้วย _test
# เทสจะ TRUNCATE ทุกตาราง จึงห้ามชี้ไปฐานข้อมูลจริง เว้นว่าง = ข้ามเทสกลุ่มนี้
TEST_DATABASE_URL=

# ใช้เมื่อ deploy หลาย instance หรือ self-host: ตั้งคีย์เข้ารหัส Server Actions ให้ตรงกันทุก instance
# (ไม่ตั้ง Next จะสุ่มใหม่ทุก build — instance ต่างกันจะเรียก action ของกันและกันไม่ได้) ดูเอกสาร Next: data-security
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ที่เก็บสลิปโอนเงิน (ส่วนตัว ไม่มี URL สาธารณะ)
#   local    = เขียนลงโฟลเดอร์ storage/slips — ใช้ได้เฉพาะโฮสต์ที่ดิสก์ถาวร (VPS / เครื่องตัวเอง)
#   disabled = ปิดการแนบสลิปผ่านเว็บ หน้าคำสั่งซื้อจะให้ลูกค้าส่งสลิปทาง LINE แทน
# บนโฮสต์ที่ดิสก์ไม่ถาวร (Vercel, Lambda, Netlify, Cloud Run) ค่า local หรือเว้นว่างจะทำให้เซิร์ฟเวอร์ไม่เริ่ม (กันสลิปหาย)
# ต้องตั้ง disabled ไปก่อน จนกว่าจะเพิ่มที่เก็บแบบ object storage ใน src/lib/slip-storage.ts
SLIP_STORAGE=local
SLIP_LOCAL_DIR=

# การชำระเงินด้วยบัตร (ข้อมูลบัตรไม่ผ่านและไม่ถูกเก็บในระบบเรา — กรอกที่ผู้ให้บริการรับชำระเท่านั้น)
#   เว้นว่าง = ยังไม่เปิดรับชำระ: หน้าคำสั่งซื้อแสดง "ระบบชำระเงินยังไม่เปิดให้บริการ / สอบถามทาง LINE" แทนปุ่มชำระ
#   mock     = จำลองการชำระเงิน (โหมดทดสอบ) ไม่มีการตัดเงินจริง — กดยืนยันแล้วคำสั่งซื้อเป็น "ชำระแล้ว" ทันที
#   ค่าอื่น   = ตั้งค่าผิด ถือว่าปิด (production เซิร์ฟเวอร์จะไม่เริ่ม)
# ยังไม่ได้เลือก payment gateway จริง — เมื่อเลือกแล้วเพิ่มใน src/lib/payment/provider.ts
PAYMENT_PROVIDER=
# mock ใช้ได้เองเฉพาะ NODE_ENV=development หรือ test (npm run dev / เทส) — NODE_ENV อื่นทุกค่า (production, ไม่ตั้ง, staging ฯลฯ
# รวม `next start` และสคริปต์) ต้องตั้งค่านี้เป็น true ตรงตัว จึงจะทำงาน ใช้กับระบบทดสอบเท่านั้น
# mock ถูกปฏิเสธเสมอเมื่อ LICENSE_STORAGE=firebase กับ FIREBASE_LICENSE_PATH="CME_Data/Customer Data/Data" (รายชื่อจริง หรือ path ใต้มัน)
# คำสั่งซื้อที่ชำระด้วย mock จะไม่เปิด license ในระบบที่ไม่อนุญาต mock และรายชื่อจริงจะไม่ถูกเผยแพร่ถ้ายังมี license จาก mock
# — ห้ามใช้ DATABASE_URL ร่วมกันระหว่างระบบที่เปิด mock กับระบบจริง (ล้างด้วย npm run license:purge-mock ถ้าต้องใช้ฐานเดิม)
PAYMENT_MOCK_ALLOW_IN_PRODUCTION=
# true = แสดงช่องทางโอนเงิน/PromptPay + แนบสลิปให้ลูกค้าด้วย (ค่าเริ่มต้นปิด: บัตรเป็นช่องทางเดียว)
# ข้อควรรู้: รอบนี้ยังไม่มีขั้นตอนยืนยันสลิป คำสั่งซื้อที่แนบสลิปจะค้างที่ "รอตรวจสลิป" และไม่เปิด license เอง
PAYMENT_BANK_TRANSFER_ENABLED=

# บัญชีรับเงินที่แสดงในหน้าคำสั่งซื้อ — ใช้เฉพาะเมื่อ PAYMENT_BANK_TRANSFER_ENABLED=true
# 3 ค่าแรกต้องครบ ไม่ครบหน้าเว็บจะบอกให้ลูกค้าสอบถามทาง LINE
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
# ไม่บังคับ
PAYMENT_PROMPTPAY_ID=

# IP ของผู้ใช้สำหรับ rate limit (สมัครสมาชิก/เข้าสู่ระบบ) — ต้องตั้งให้ตรงกับ proxy ที่อยู่หน้าเว็บจริง
# ระบบไม่เชื่อ X-Forwarded-For ที่ผู้ใช้ส่งมาเอง: ถ้าไม่ตั้งค่าใดเลย จะระบุ IP ไม่ได้ และใช้เพดานรวมทั้งระบบแทนเพดานต่อ IP
# (มีคำเตือนใน log ตอน production) เลือกตั้งอย่างใดอย่างหนึ่ง:
#   TRUSTED_PROXY_HOPS = จำนวน proxy ของเราที่ต่อท้าย X-Forwarded-For เช่น nginx 1 ชั้นหน้า `next start` = 1
#   CLIENT_IP_HEADER   = ชื่อ header ที่แพลตฟอร์มเขียนทับเองเสมอ เช่น cf-connecting-ip (Cloudflare)
# บน Vercel ไม่ต้องตั้ง (ระบบใช้ 1 hop ให้เอง เพราะ Vercel เขียนทับ X-Forwarded-For)
# อย่าตั้งถ้าเปิด `next start` รับคำขอจากอินเทอร์เน็ตตรงๆ โดยไม่มี proxy — header จะเป็นค่าที่ผู้ใช้ปลอมได้
TRUSTED_PROXY_HOPS=
CLIENT_IP_HEADER=
